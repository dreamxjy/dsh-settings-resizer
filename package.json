{
  "name": "dsh-settings-resizer",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "description": "Make the Harness settings window resizable and configurable in size.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamxjy/dsh-settings-resizer.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-256.png",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
